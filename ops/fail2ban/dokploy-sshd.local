# Managed by prepare-dokploy-debian13.sh
[sshd]
enabled = true
mode = aggressive

# Бан на полчаса и пять попыток: обрыв соединения у администратора при
# нестабильной сети не должен закрывать доступ к хосту на час.
bantime = 1800
findtime = 600
maxretry = 5

# Административный доступ: бан блокирует весь IP, включая 443, поэтому
# обрыв соединения здесь обернулся недоступностью витрины.
ignoreip = 127.0.0.1/8 ::1 213.139.219.6
