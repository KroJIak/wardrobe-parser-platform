[sshd]
enabled = true
# Свой фильтр: бан только за перебор логинов и паролей. Обычный обрыв
# соединения (нестабильная сеть, сканер портов) больше не приводит к бану —
# бан действует на весь адрес, включая 443, и закрывал витрину.
filter = sshd-wardrobe
bantime = 1800
findtime = 600
maxretry = 5
ignoreip = 127.0.0.1/8 ::1 213.139.219.6
